{
  "name": "bitty-tui",
  "version": "1.0.1",
  "license": "MIT",
  "repository": "https://github.com/mceck/bitty",
  "keywords": [
    "bitwarden",
    "vaultwarden",
    "tui",
    "cli",
    "terminal",
    "ink",
    "react"
  ],
  "bin": {
    "bitty": "dist/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "watch": "tsc --watch",
    "dev": "tsc && node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "argon2": "^0.44.0",
    "chalk": "^5.6.2",
    "clipboardy": "^5.3.1",
    "commander": "^15.0.0",
    "ink": "^7.1.0",
    "jsqr": "^1.4.0",
    "otplib": "^13.4.0",
    "pngjs": "^7.0.0",
    "prompts": "^2.4.2",
    "react": "^19.2.5",
    "read-package-up": "^12.0.0"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^8.1.0",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ]
  }
}
