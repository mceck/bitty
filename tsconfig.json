{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "erasableSyntaxOnly": false,
    "rootDir": "src",
    "outDir": "dist",
    "module": "node20",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["src"]
}
